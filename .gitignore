# ── 数据库（522MB，可由爬虫/回填重建，绝不入库）──
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.db.gz
data_snapshot.*
data/classify_batch.json
data/classify_results.json

# ── 备份 / 临时 ──
*.bak
*.bak-*
*.log
*.tmp

# ── Python ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# ── 原始数据源 / 旧独立版本（含 ABDC 版权 xlsx；服务器用 data/abdc_data.json）──
*.xlsx
*.xls
/abdc/

# ── 后台任务输出 / 编辑器 ──
tasks/
.vscode/
.idea/
.DS_Store

# ── 机器本地 / 工具产物（含本地路径、用户名，勿入公开仓库）──
.claude/
.playwright-cli/
output/playwright/
pbc_found_links.json
pbc_search_found.json
pbc_*.json
backups/
data/astar_emb*.npy
data/astar_emb_meta.json
data/astar_texts.jsonl.gz
# 安居客商业挂牌数据仅限本机：不得进入公开仓库或 pboc_data.db 快照
data/housing_listing.db*
data/anjuke_raw/
# 论文翻译原件、检查点与译文仅限本机，绝不进入公开仓库
data/translation_jobs/
data/translation_runtime.json
data/audio_jobs/
data/audio_runtime.json
data/audio_smoke/
# PDF 阅读副本的上传原件、EPUB、裁边 PDF 与打包 ZIP 只保存在本机
data/ebook_jobs/
# Academic Career: public source rows are local working data; profile and
# application notes are personal data and must never enter the repository.
data/faculty_jobs.db*
data/faculty_jobs_cache/
data/faculty_job_profile.json
data/faculty_jobs_private/
# 悦读FM 音频、封面、RSS 快照与本地元数据只保存在本机
data/yuedu_fm/
# 香港宏观官方源原始快照只保存在本机，保留摘要/哈希在数据库审计表
data/hong_kong_macro_raw/
# 中国 SAFE 官方储备/外部源原始快照只保存在本机
data/china_macro_raw/
.secrets
.env
.env.local
outputs/*.db
outputs/*.log
outputs/*.jsonl
# 本地界面 QA 截图，仅用于实现核验，不进入公开仓库
outputs/research-navigation-qa/

# ── 单仓库 1+5 边界：本机代理状态与临时抓取结果 ──
.agents/
.codex/
/NUL
/tmp/
/claudetmp*
/tmp*.json
/tmp*.txt

# 出版社摘要逐条文本与授权探测仅留私有备份；公开仓库只保留代码和状态说明
data/astar_verified_abstract_overrides.json
data/astar_*probe*.json
data/astar_abstract_full_scan*/
data/astar_elsevier_*/
data/research_sources/
# OCR text and page manifests are derived private reading aids; keep the
# supplied source file outside the repository and do not publish extracted text.
data/research_source_text/
# Human evidence ledger may contain page notes or short excerpts from private
# source copies; keep it local and separate from the generated catalog.
data/research_evidence/

# 私有迁移执行产物只能写到仓库外；仓库内若误生成则保持忽略
outputs/private-migration*/
