{
  "schema_version": 1,
  "layout": "one_plus_five",
  "repository": {
    "name": "research-tools-suite",
    "runtime_entrypoint": "server.py",
    "health_endpoint": "/api/health",
    "default_port": 5001,
    "public_git_policy": "source_docs_tests_and_small_reproducible_inputs_only",
    "max_public_file_bytes": 20971520
  },
  "shared": {
    "source_globs": [
      "server.py",
      "requirements.txt",
      "README.md",
      "static/index.html",
      "static/research-nav.js",
      "static/research-nav.css",
      "scripts/watchdog.py",
      "scripts/watchdog.bat",
      "tests/test_core_guards.py",
      "tests/test_research_navigation.py",
      "tests/test_server_access_security.py"
    ],
    "private_data_globs": [
      ".secrets",
      ".env",
      ".env.*",
      "*.db",
      "*.db-wal",
      "*.db-shm",
      "*.bak",
      "*.bak-*",
      "*.log",
      "backups/**",
      "output/**",
      "outputs/*.db",
      "outputs/*.jsonl",
      "outputs/*.log",
      "tmp/**"
    ]
  },
  "projects": [
    {
      "id": "china_macro",
      "nav_key": "china",
      "nav_label": "中国宏观",
      "name": "中国宏观、财政、城市与住房",
      "default_route": "/dashboard",
      "routes": [
        "/dashboard",
        "/china-macro",
        "/macro-analytics",
        "/gdp",
        "/housing",
        "/fiscal-debt",
        "/debt-ceiling",
        "/china-rates",
        "/city-economy",
        "/housing-scenario"
      ],
      "source_globs": [
        "services/china_*.py",
        "services/financial_*.py",
        "services/fiscal_*.py",
        "services/debt_*.py",
        "services/pboc_*.py",
        "services/mof_*.py",
        "services/city_*.py",
        "services/housing_*.py",
        "services/anjuke_*.py",
        "services/gdp_service.py",
        "services/listed_company_service.py",
        "services/macro_analytics_service.py",
        "services/regional_fiscal_service.py",
        "static/china_*.html",
        "static/fiscal_*.html",
        "static/debt_*.html",
        "static/city_*.html",
        "static/city-*.js",
        "static/gdp.html",
        "static/housing*.html",
        "static/housing*.js",
        "tests/test_china_*.py",
        "tests/test_fiscal_*.py",
        "tests/test_debt_*.py",
        "tests/test_city_*.py",
        "tests/test_housing*.py",
        "tests/test_gdp_service.py",
        "tests/test_listed_company_service.py"
      ],
      "tracked_data": [
        "data/china_macro_annual_official.csv",
        "data/china_macro_official_backfill.csv",
        "data/china_regional_official_TEMPLATE.csv",
        "data/housing_demographic_capacity_inputs.csv",
        "data/housing_nbs_annual_sales_history.csv",
        "data/housing_structural_drivers.csv"
      ],
      "private_data_globs": [
        "pboc_data.db*",
        "data/housing_listing.db*",
        "data/lgfv_bond.db*",
        "data/anjuke_raw/**"
      ]
    },
    {
      "id": "us_macro",
      "nav_key": "us",
      "nav_label": "美国宏观",
      "name": "美国宏观",
      "default_route": "/us-macro",
      "routes": [
        "/us-macro"
      ],
      "shared_routes": [
        "/gdp",
        "/macro-analytics"
      ],
      "source_globs": [
        "services/us_macro_service.py",
        "static/us_macro.html",
        "tests/test_macro_analytics.py"
      ],
      "tracked_data": [],
      "private_data_globs": []
    },
    {
      "id": "abdc_research",
      "nav_key": "research",
      "nav_label": "ABDC 商科研究",
      "name": "ABDC 商科研究",
      "default_route": "/abdc-astar-research",
      "routes": [
        "/abdc",
        "/abdc-astar-research"
      ],
      "source_globs": [
        "services/abdc_*.py",
        "services/astar_*.py",
        "services/aim_extract.py",
        "static/abdc*.html",
        "scripts/*abdc*.py",
        "scripts/*astar*.py",
        "scripts/*aim*.py",
        "tests/test_astar*.py",
        "tests/test_aim*.py",
        "profiles/**"
      ],
      "tracked_data": [
        "data/abdc_data.json"
      ],
      "private_data_globs": [
        "abdc/**",
        "data/astar_interest.db*",
        "data/astar_emb*.npy",
        "data/astar_emb_meta.json",
        "data/astar_texts.jsonl.gz",
        "data/astar_verified_abstract_overrides.json",
        "data/astar_*probe*.json",
        "data/astar_abstract_full_scan*/**",
        "data/astar_elsevier_*/**"
      ]
    },
    {
      "id": "research_tools",
      "nav_key": "tools",
      "nav_label": "科研工具",
      "name": "科研语言与语音工具",
      "default_route": "/paper-translation",
      "routes": [
        "/paper-translation",
        "/audio-transcription"
      ],
      "source_globs": [
        "services/paper_*.py",
        "services/pdf_*.py",
        "services/audio_*.py",
        "static/paper_*.html",
        "static/audio_*.html",
        "scripts/*translation*.py",
        "scripts/*translation*.sh",
        "scripts/*audio*.py",
        "tests/test_paper_*.py",
        "tests/test_audio_*.py"
      ],
      "tracked_data": [],
      "private_data_globs": [
        "data/translation_jobs/**",
        "data/translation_runtime.json",
        "data/audio_jobs/**",
        "data/audio_runtime.json",
        "data/audio_smoke/**"
      ]
    },
    {
      "id": "personal_tools",
      "nav_key": "leisure",
      "nav_label": "娱乐",
      "name": "个人归档与按需监控",
      "default_route": "/yuedu-fm",
      "routes": [
        "/yuedu-fm",
        "/cardcookie-monitor"
      ],
      "source_globs": [
        "services/yuedu_*.py",
        "services/cardcookie_*.py",
        "static/yuedu_*.html",
        "static/cardcookie_*.html",
        "scripts/*yuedu*.py",
        "tests/test_yuedu_*.py",
        "tests/test_cardcookie_*.py"
      ],
      "tracked_data": [],
      "private_data_globs": [
        "data/yuedu_fm/**",
        "data/cardcookie_monitor.db*"
      ]
    }
  ]
}
