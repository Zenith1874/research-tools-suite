{
  "schema_version": 1,
  "layout": "one_plus_six",
  "repository": {
    "name": "research-tools-suite",
    "runtime_entrypoint": "server.py",
    "health_endpoint": "/api/health",
    "default_port": 5001,
    "public_git_policy": "source_docs_tests_and_small_reproducible_inputs_only",
    "max_public_file_bytes": 20971520
  },
  "shared": {
    "source_globs": [
      "server.py",
      "requirements.txt",
      "README.md",
      "static/index.html",
      "static/research-nav.js",
      "static/research-nav.css",
      "scripts/watchdog.py",
      "scripts/watchdog.bat",
      "tests/test_core_guards.py",
      "tests/test_research_navigation.py",
      "tests/test_server_access_security.py",
      "scripts/audit_projects.py",
      "scripts/audit_one_plus_five.py"
    ],
    "private_data_globs": [
      ".secrets",
      ".env",
      ".env.*",
      ".agents/**",
      ".claude/**",
      ".codex/**",
      ".playwright-cli/**",
      "*.db",
      "*.db-wal",
      "*.db-shm",
      "*.bak",
      "*.bak-*",
      "*.log",
      "backups/**",
      "data/classify_batch.json",
      "data/classify_results.json",
      "logs/**",
      "output/**",
      "outputs/*.db",
      "outputs/*.jsonl",
      "outputs/*.log",
      "outputs/research-navigation-qa/**",
      "output/**",
      "tasks/**",
      "data/china_macro_raw/**",
      "data/hong_kong_macro_raw/**",
      "abdc/**",
      "*.db.gz",
      "*.sqlite",
      "*.sqlite3",
      "*.sqlite-wal",
      "*.sqlite-shm",
      "*.sqlite3-wal",
      "*.sqlite3-shm",
      "*.sqlite3-journal",
      "*.xlsx",
      "*.xls",
      "NUL",
      "pbc_found_links.json",
      "pbc_search_found.json",
      "static/*.bak-*",
      "data/backups/**",
      "tmp/**"
    ],
    "disposable_globs": [
      "**/__pycache__/**",
      "**/*.pyc",
      "NUL",
      "claudetmp*",
      "tmp*.json",
      "tmp*.txt"
    ]
  },
  "projects": [
    {
      "id": "china_macro",
      "nav_key": "china",
      "nav_label": "中国宏观",
      "name": "中国宏观、财政、城市与住房",
      "default_route": "/dashboard",
      "routes": [
        "/dashboard",
        "/china-macro",
        "/hong-kong-macro",
        "/macro-analytics",
        "/gdp",
        "/housing",
        "/fiscal-debt",
        "/debt-ceiling",
        "/china-rates",
        "/city-economy",
        "/housing-scenario"
      ],
      "source_globs": [
        "services/china_*.py",
        "services/hong_kong_macro_service.py",
        "services/financial_*.py",
        "services/fiscal_*.py",
        "services/debt_*.py",
        "services/pboc_*.py",
        "services/mof_*.py",
        "services/city_*.py",
        "services/housing_*.py",
        "services/anjuke_*.py",
        "services/gdp_service.py",
        "services/listed_company_service.py",
        "services/macro_analytics_service.py",
        "services/regional_fiscal_service.py",
        "static/china_*.html",
        "static/fiscal_*.html",
        "static/debt_*.html",
        "static/city_*.html",
        "static/city-*.js",
        "static/gdp.html",
        "static/housing*.html",
        "static/housing*.js",
        "tests/test_china_*.py",
        "tests/test_hong_kong_macro_service.py",
        "tests/test_fiscal_*.py",
        "tests/test_debt_*.py",
        "tests/test_city_*.py",
        "tests/test_housing*.py",
        "tests/test_gdp_service.py",
        "tests/test_listed_company_service.py"
      ],
      "tracked_data": [
        "data/china_macro_annual_official.csv",
        "data/china_macro_official_backfill.csv",
        "data/china_regional_official_TEMPLATE.csv",
        "data/housing_demographic_capacity_inputs.csv",
        "data/housing_nbs_annual_sales_history.csv",
        "data/housing_nbs_sales_release_manifest.csv",
        "data/housing_structural_drivers.csv"
      ],
      "private_data_globs": [
        "pboc_data.db*",
        "data/housing_listing.db*",
        "data/lgfv_bond.db*",
        "data/anjuke_raw/**"
      ]
    },
    {
      "id": "us_macro",
      "nav_key": "us",
      "nav_label": "美国宏观",
      "name": "美国宏观",
      "default_route": "/us-macro",
      "routes": [
        "/us-macro"
      ],
      "shared_routes": [
        "/gdp",
        "/macro-analytics"
      ],
      "source_globs": [
        "services/us_macro_service.py",
        "static/us_macro.html",
        "tests/test_macro_analytics.py"
      ],
      "tracked_data": [],
      "private_data_globs": []
    },
    {
      "id": "abdc_research",
      "nav_key": "research",
      "nav_label": "ABDC 商科研究",
      "name": "ABDC 商科研究",
      "default_route": "/abdc-astar-research",
      "routes": [
        "/abdc",
        "/abdc-astar-research",
        "/abdc/research",
        "/research"
      ],
      "source_globs": [
        "services/abdc_*.py",
        "services/astar_*.py",
        "services/aim_extract.py",
        "static/abdc*.html",
        "scripts/*abdc*.py",
        "scripts/*astar*.py",
        "scripts/*aim*.py",
        "tests/test_astar*.py",
        "tests/test_aim*.py",
        "profiles/**",
        "services/business_research_service.py",
        "static/business_research.*",
        "scripts/*research_catalog*.py",
        "scripts/*research_evidence*.py",
        "scripts/*research_source*.py",
        "scripts/verify_research_sources.py",
        "scripts/resolve_research_source_access.py",
        "scripts/ocr_research_source.py",
        "scripts/seed_book60_evidence.py",
        "tests/test_business_research*.py",
        "tests/test_research_*.py",
        "tests/test_book60_evidence_seed.py",
        "services/astar_affiliation_service.py",
        "scripts/backfill_astar_affiliations.py",
        "tests/test_astar_affiliations.py"
      ],
      "tracked_data": [
        "data/abdc_data.json",
        "data/research_catalog.json"
      ],
      "private_data_globs": [
        "abdc/**",
        "data/astar_interest.db*",
        "data/astar_emb*.npy",
        "data/astar_emb_meta.json",
        "data/astar_texts.jsonl.gz",
        "data/astar_verified_abstract_overrides.json",
        "data/astar_*probe*.json",
        "data/astar_abstract_full_scan*/**",
        "data/astar_elsevier_*/**",
        "data/business_research_state.db*",
        "data/research_source_text/**",
        "data/research_sources/**",
        "data/research_evidence/**",
        "data/backups/astar_*/**",
        "outputs/astar_affiliation_backfill_*.log"
      ]
    },
    {
      "id": "research_tools",
      "nav_key": "tools",
      "nav_label": "科研工具",
      "name": "科研语言、语音与阅读副本工具",
      "default_route": "/ebook-conversion",
      "routes": [
        "/paper-translation",
        "/audio-transcription",
        "/ebook-conversion"
      ],
      "source_globs": [
        "services/paper_*.py",
        "services/pdf_*.py",
        "services/audio_*.py",
        "services/ebook_*.py",
        "static/paper_*.html",
        "static/audio_*.html",
        "static/ebook_*.html",
        "scripts/*translation*.py",
        "scripts/*translation*.sh",
        "scripts/*audio*.py",
        "tests/test_paper_*.py",
        "tests/test_audio_*.py",
        "tests/test_ebook_*.py"
      ],
      "tracked_data": [],
      "private_data_globs": [
        "data/translation_jobs/**",
        "data/translation_runtime.json",
        "data/audio_jobs/**",
        "data/audio_runtime.json",
        "data/audio_smoke/**",
        "data/ebook_jobs/**"
      ]
    },
    {
      "id": "personal_tools",
      "nav_key": "leisure",
      "nav_label": "娱乐",
      "name": "个人归档与按需监控",
      "default_route": "/yuedu-fm",
      "routes": [
        "/yuedu-fm",
        "/cardcookie-monitor"
      ],
      "source_globs": [
        "services/yuedu_*.py",
        "services/cardcookie_*.py",
        "static/yuedu_*.html",
        "static/cardcookie_*.html",
        "scripts/*yuedu*.py",
        "tests/test_yuedu_*.py",
        "tests/test_cardcookie_*.py"
      ],
      "tracked_data": [],
      "private_data_globs": [
        "data/yuedu_fm/**",
        "data/cardcookie_monitor.db*"
      ]
    },
    {
      "id": "academic_career",
      "nav_key": "career",
      "nav_label": "学术职业",
      "name": "Academic Career / Faculty Job Market",
      "default_route": "/faculty-jobs",
      "routes": [
        "/faculty-jobs",
        "/school-explorer",
        "/job-market-analytics",
        "/my-applications"
      ],
      "source_globs": [
        "services/faculty_job*.py",
        "services/faculty_jobs*.py",
        "services/faculty_jobs_sources/*.py",
        "static/faculty_jobs.*",
        "static/school_explorer.*",
        "static/job_market_analytics.*",
        "static/my_applications.*",
        "scripts/*faculty*job*.py",
        "tests/test_faculty_jobs*.py",
        "tests/fixtures/faculty_jobs/**",
        "projects/academic_career/**"
      ],
      "tracked_data": [
        "data/faculty_job_taxonomy.json",
        "data/faculty_job_rank_mappings.json",
        "data/faculty_school_tier_rules.json"
      ],
      "private_data_globs": [
        "data/faculty_jobs.db*",
        "data/faculty_jobs_cache/**",
        "data/faculty_job_profile.json",
        "data/faculty_jobs_private/**"
      ]
    }
  ]
}
